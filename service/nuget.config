<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Use the public NuGet feed only. Overrides any machine/user config (e.g. a
    corporate Artifactory feed and its package-source mapping) so the service
    restores from public packages on any machine.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
